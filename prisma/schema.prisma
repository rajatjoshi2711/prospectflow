// ProspectFlow — Prisma schema
// Full data model per the approved build plan. Only the Organization/User
// pieces are wired up to application code in Phase 1 (Foundation); the rest
// of the models exist now so later phases can build on a stable schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / org
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MEMBER
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  emailDomain String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  icps             ICP[]
  channelPartners  ChannelPartner[]
  quickSuggestions QuickSuggestion[]
  prospectNotes    ProspectNote[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(MEMBER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastImportAt   DateTime?
  /// Phase 7. When relationship scoring was last ASKED for (import completed,
  /// nightly sweep, or the user pressing "re-score now"). Paired with
  /// `relationshipScoreComputedAt` this is the only honest way the UI can say
  /// "scoring is running" — Inngest runs out of band, so without a requested/
  /// computed pair the dashboard cannot tell "no scores yet because the job is
  /// mid-flight" from "no scores because there is no interaction data".
  relationshipScoreRequestedAt DateTime?
  /// When the per-user scoring run last FINISHED, written by
  /// `computeRelationshipScoresForUser` on every exit path (including the
  /// no-import and no-signal ones, which are finished runs too).
  relationshipScoreComputedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  importBatches              ImportBatch[]
  campaigns                  Campaign[]
  chatMessages               ChatMessage[]
  relationshipStrengthScores RelationshipStrengthScore[]
  quickSuggestions           QuickSuggestion[]
  connectionMarks            ConnectionMark[]
  prospectNotes              ProspectNote[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Ingestion
// ---------------------------------------------------------------------------

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model ImportBatch {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       ImportBatchStatus @default(PENDING)
  blobUrl      String
  fileCount    Int?
  errorMessage String?
  /// Display name of the account owner for this export, resolved at ingestion
  /// time from Profile.csv when present, else from `User.name`. Used to decide
  /// which party in a message/invitation is the counterparty. Null on batches
  /// imported before this field existed.
  ownerName    String?
  /// `computeNameKey(ownerName)` — precomputed so counterparty resolution never
  /// has to re-normalize at query time.
  ownerNameKey String?
  createdAt    DateTime          @default(now())
  completedAt  DateTime?

  connections Connection[]
  positions   Position[]
  invitations Invitation[]
  messages    MessageRecord[]
  rawCsvRows  RawCsvRow[]

  jobChangeEventsAsPrevious JobChangeEvent[] @relation("PreviousBatch")
  jobChangeEventsAsCurrent  JobChangeEvent[] @relation("CurrentBatch")

  @@index([userId])
  @@index([userId, status, completedAt])
}

model Connection {
  id            String      @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  /// Strong key: `url:<normalized profile url>`, else `fallback:sha256(...)`.
  identityKey   String
  /// Weak key: `name:<normalized display name>`. Non-unique — see
  /// src/lib/ingestion/identity-key.ts. Null on pre-existing rows.
  nameKey       String?
  firstName     String?
  lastName      String?
  linkedinUrl   String?
  email         String?
  company       String?
  position      String?
  connectedOn   DateTime?
  country       String?
  createdAt     DateTime    @default(now())

  /// The EFFECTIVE relationship strength shown for this connection, 0-100,
  /// materialized by the scoring run (`src/lib/relationship/run.ts`).
  ///
  /// It exists because sorting and paging are server-side. The displayed value
  /// resolves to a stored `RelationshipStrengthScore` for a capped subset and
  /// to a read-time heuristic for everyone else, so ordering by the score table
  /// alone would produce an order that contradicts the numbers on screen —
  /// and Prisma cannot order by a to-many relation anyway. Same lesson as
  /// `CampaignLead.status`: a value the column does not know about cannot be
  /// counted, filtered or sorted.
  ///
  /// NULL means "not yet scored" — no interaction data at all, or no scoring
  /// run since this batch was imported. It must never be written as 0: zero
  /// reads as "a weak relationship" when the truth is "no data".
  relationshipScore Int?
  /// `ai` when the materialized score came from the model pass, `heuristic`
  /// when it came from the deterministic rules. Null alongside a null score.
  relationshipBasis String?

  prospectMatches            ProspectMatch[]
  campaignLeads              CampaignLead[]
  relationshipStrengthScores RelationshipStrengthScore[]
  quickSuggestions           QuickSuggestion[]

  @@index([importBatchId])
  @@index([identityKey])
  @@index([nameKey])
  @@index([importBatchId, identityKey])
  /// Backs the "sort by relationship strength" order on every prospect table:
  /// the batch filter and the sort key in one index.
  @@index([importBatchId, relationshipScore])
}

/// The ACCOUNT OWNER's own work history, from `Positions.csv`.
///
/// This is emphatically NOT the job history of the user's connections — a
/// LinkedIn export only ever contains the owner's positions. Connection job
/// changes are detected by diffing `Connection.company` / `Connection.position`
/// between batches (see `diffJobChanges`), never from this table.
model Position {
  id             String      @id @default(cuid())
  importBatchId  String
  importBatch    ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  identityKey    String
  /// Always true for rows ingested from `Positions.csv`. Present so the
  /// "these are the owner's jobs, not a connection's" fact is queryable and
  /// this table is never mistaken for connection history again.
  isAccountOwner Boolean     @default(true)
  companyName    String?
  title          String?
  location       String?
  startedOn      DateTime?
  finishedOn     DateTime?
  createdAt      DateTime    @default(now())

  @@index([importBatchId])
  @@index([identityKey])
}

model Invitation {
  id               String      @id @default(cuid())
  importBatchId    String
  importBatch      ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  /// Keyed to the COUNTERPARTY (the other person, not the account owner).
  identityKey      String
  /// Weak key for the counterparty: `name:<normalized display name>`.
  nameKey          String?
  /// The counterparty's display name, as it appeared in the export.
  counterpartyName String?
  direction        String?
  from             String?
  to               String?
  sentAt           DateTime?
  message          String?
  createdAt        DateTime    @default(now())

  @@index([importBatchId])
  @@index([identityKey])
  @@index([nameKey])
}

model MessageRecord {
  id               String      @id @default(cuid())
  importBatchId    String
  importBatch      ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  /// Keyed to the COUNTERPARTY, never to the account owner — so a conversation
  /// is retrievable by "who it is with" regardless of who sent each message.
  /// Direction is carried separately by `senderIsUser`.
  identityKey      String
  /// Weak key for the counterparty: `name:<normalized display name>`.
  nameKey          String?
  /// The counterparty's display name, as it appeared in the export.
  counterpartyName String?
  /// True when the account owner sent this message. Null when the owner could
  /// not be identified (legacy rows, or an export with no Profile.csv and no
  /// usable `User.name`).
  senderIsUser     Boolean?
  conversationId   String?
  from             String?
  to               String?
  sentAt           DateTime?
  content          String?
  createdAt        DateTime    @default(now())

  @@index([importBatchId])
  @@index([identityKey])
  @@index([nameKey])
  @@index([conversationId])
}

model RawCsvRow {
  id             String      @id @default(cuid())
  importBatchId  String
  importBatch    ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  sourceFilename String
  rowData        Json
  createdAt      DateTime    @default(now())

  @@index([importBatchId])
  @@index([sourceFilename])
}

/// A connection whose company or title differs between the two most recent
/// COMPLETE import batches for a user. Derived from `Connection` rows — the
/// only place a connection's employer actually appears in a LinkedIn export.
model JobChangeEvent {
  id              String      @id @default(cuid())
  /// The `Connection.identityKey` of the person who moved.
  identityKey     String
  /// Denormalized display details, captured at detection time so the UI can
  /// render the alert without a second lookup (and so it still reads correctly
  /// if the person disappears from a later export).
  personName      String?
  linkedinUrl     String?
  previousBatchId String
  previousBatch   ImportBatch @relation("PreviousBatch", fields: [previousBatchId], references: [id], onDelete: Cascade)
  currentBatchId  String
  currentBatch    ImportBatch @relation("CurrentBatch", fields: [currentBatchId], references: [id], onDelete: Cascade)
  previousTitle   String?
  previousCompany String?
  newTitle        String?
  newCompany      String?
  detectedAt      DateTime    @default(now())

  @@index([identityKey])
  @@index([currentBatchId])
}

// ---------------------------------------------------------------------------
// ICP / channel partner matching
// ---------------------------------------------------------------------------

model ICP {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  country        String?
  industry       String?
  positions      String[]
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  prospectMatches ProspectMatch[]

  @@index([organizationId])
}

model ChannelPartner {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  industry       String?
  criteria       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  prospectMatches ProspectMatch[]

  @@index([organizationId])
}

/// Which kind of definition a match was scored against. Redundant with
/// `icpId`/`channelPartnerId` being set, but stored explicitly so dashboards
/// can filter on one indexed column instead of a null-check.
enum MatchType {
  ICP
  CHANNEL_PARTNER
}

/// A scored link between one `Connection` and one `ICP` or `ChannelPartner`.
///
/// IDEMPOTENCY: exactly one of `icpId` / `channelPartnerId` is set, and the
/// pair (connection, definition) is UNIQUE. Re-scoring therefore upserts in
/// place — re-running the matching job, or re-saving an ICP, updates the score
/// and rationale rather than accumulating duplicate rows. Postgres treats
/// NULLs as distinct in unique indexes, so the two constraints below never
/// collide with each other.
model ProspectMatch {
  id               String          @id @default(cuid())
  connectionId     String
  connection       Connection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  matchType        MatchType
  icpId            String?
  icp              ICP?            @relation(fields: [icpId], references: [id], onDelete: Cascade)
  channelPartnerId String?
  channelPartner   ChannelPartner? @relation(fields: [channelPartnerId], references: [id], onDelete: Cascade)
  score            Int
  rationale        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([connectionId, icpId])
  @@unique([connectionId, channelPartnerId])
  @@index([connectionId])
  @@index([icpId, score])
  @@index([channelPartnerId, score])
  @@index([matchType, score])
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

enum CampaignLeadStatus {
  REQUEST_PENDING
  REQUEST_ACCEPTED
  FIRST_MESSAGE_SENT
  CONVERSATION_ONGOING
}

/// Lifecycle of an uploaded lead list, mirroring `ImportBatchStatus` — with one
/// extra state, because campaign ingestion deliberately pauses for a human.
///
///   PENDING               blob uploaded, detection queued
///   DETECTING             background job is sampling the file
///   AWAITING_CONFIRMATION detection finished; the user must confirm (or
///                         override) the LinkedIn-URL column before any lead is
///                         written. The detected column drives every downstream
///                         match, so a silent wrong guess is costly.
///   PROCESSING            confirmed; leads are being created and linked
///   COMPLETE / FAILED     terminal
enum CampaignStatus {
  PENDING
  DETECTING
  AWAITING_CONFIRMATION
  PROCESSING
  COMPLETE
  FAILED
}

model Campaign {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  sourceFileName      String?
  status              CampaignStatus @default(PENDING)
  /// Vercel Blob URL of the uploaded spreadsheet. The store is private, so it
  /// is only ever read server-side via `get()` from `@vercel/blob`.
  blobUrl             String?
  /// The column the user CONFIRMED holds LinkedIn profile URLs. Null until
  /// confirmation; this — not `detectedColumn` — is what lead creation reads.
  linkedinColumn      String?
  /// What detection proposed, kept alongside the confirmed value so an
  /// override stays visible/auditable.
  detectedColumn      String?
  detectionConfidence Float?
  /// "heuristic" | "heuristic-weak" | "llm" | "none" — see
  /// src/lib/campaigns/detect-column.ts.
  detectionMethod     String?
  /// Header row of the uploaded sheet, so the override picker can be rendered
  /// without re-downloading and re-parsing the blob.
  columnHeaders       String[]
  /// The same sampled rows detection ran on, as `Record<string,string>[]`.
  /// Bounded to `DETECTION_SAMPLE_ROWS`, purely for the confirmation preview.
  sampleRows          Json?
  leadCount           Int?
  /// How many leads resolved to a `Connection` in the user's latest completed
  /// import. Surfaced so "not yet scored" rows are explained rather than
  /// looking broken.
  matchedLeadCount    Int?
  errorMessage        String?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  leads CampaignLead[]

  @@index([userId])
  @@index([userId, createdAt])
  /// The client looks its just-uploaded campaign up by the blob URL that
  /// `uploadPresigned` returned (scoped to the session user), so this lookup
  /// needs to be indexed.
  @@index([blobUrl])
}

model CampaignLead {
  id           String             @id @default(cuid())
  campaignId   String
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   Connection?        @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  linkedinUrl  String?
  firstName    String?
  lastName     String?
  company      String?
  position     String?
  /// Same key design as ingestion (src/lib/ingestion/identity-key.ts):
  /// `identityKey` is `url:<normalized profile url>` when the sheet gave a
  /// URL, `nameKey` is the weak name fallback. Stored rather than recomputed
  /// so leads can be re-linked against a future import without re-parsing the
  /// original spreadsheet.
  identityKey  String?
  nameKey      String?
  status       CampaignLeadStatus @default(REQUEST_PENDING)
  /// When the user last set `status` by hand. NULL means they never have, so
  /// `status` still holds its creation default and carries no information.
  ///
  /// Without this the two are indistinguishable, and since every lead is
  /// created as REQUEST_PENDING, a stored default would always win over the
  /// status derived from real message history — pinning every lead to
  /// "Connection request pending" forever.
  statusSetAt  DateTime?
  rawRow       Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([campaignId])
  @@index([connectionId])
  @@index([campaignId, status])
  @@index([identityKey])
  @@index([nameKey])
}

// ---------------------------------------------------------------------------
// AI features
// ---------------------------------------------------------------------------

/// Relationship strength for ONE (user, connection) pair, 0-100.
///
/// Produced by the Phase 6 hybrid pipeline (src/lib/relationship): deterministic
/// feature extraction from the user's ingested messages/invitations first, then
/// an LLM turns that compact feature summary into a score + rationale. `factors`
/// carries both the raw features and the human-readable reasons, so the UI can
/// explain a score without re-deriving it.
///
/// IDEMPOTENCY: unique on (userId, connectionId), so a recompute upserts in
/// place. `connectionId` points at a row in ONE import batch — the user's latest
/// completed snapshot — which is the same batch every dashboard reads from.
///
/// ABSENCE IS MEANINGFUL: a connection with no message and no invitation is
/// deliberately NOT scored. No row means "not yet scored", never zero.
model RelationshipStrengthScore {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  score        Int
  factors      Json
  /// "ai" when the model produced the score, "heuristic" when the deterministic
  /// fallback did (no GROQ_API_KEY, or the batch degraded). Surfaced in the UI
  /// so an AI number is never passed off as a rule-based one or vice versa.
  basis        String     @default("ai")
  computedAt   DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, connectionId])
  @@index([userId])
  @@index([connectionId])
  @@index([userId, score])
}

enum ConnectionMarkValue {
  UP
  DOWN
}

/// One member's thumbs up / thumbs down on one PERSON.
///
/// WHY IT IS KEYED ON `identityKey` AND NOT ON `connectionId`
/// ---------------------------------------------------------
/// `Connection` rows are per import batch: every upload writes a whole new set
/// of rows with new ids, and the dashboards read the latest COMPLETE batch. A
/// mark keyed on `connectionId` would therefore be orphaned by the very next
/// import — the user would re-mark the same people after every upload, which
/// is precisely the thing this feature exists to avoid. `identityKey` is the
/// stable person key ingestion already writes
/// (src/lib/ingestion/identity-key.ts): `url:<normalized profile url>` for
/// essentially every Connections.csv row. It is the same key
/// `src/lib/campaigns/link.ts` uses to re-link leads across imports.
///
/// The weak `nameKey` is deliberately NOT part of the key here. It is
/// non-unique — two different people sharing a display name share a nameKey —
/// and a name-key fallback would silently move one person's mark onto another
/// person's row. A wrong relationship hint is recoverable; a wrong opinion
/// attached to the wrong face is not worth the extra coverage, especially when
/// the strong key already covers essentially every connection.
///
/// PRIVATE TO THE USER: a mark is one member's read of a person, exactly like
/// `RelationshipStrengthScore`. It is never org-wide, so every query is scoped
/// by `userId` and the unique constraint carries `userId` first.
///
/// ABSENCE IS MEANINGFUL: no row means "not marked". Clearing a mark deletes
/// the row rather than storing a third "neutral" value, so there is exactly
/// one representation of "no opinion".
model ConnectionMark {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The stable person key — see the note above. Not an FK: the person it
  /// names outlives any individual `Connection` row.
  identityKey String
  value       ConnectionMarkValue
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  /// Makes the upsert target exact and enforces "one opinion per person".
  @@unique([userId, identityKey])
  /// Backs the page read in `fetchProspectPage`: one query for the whole page,
  /// `userId` plus `identityKey IN (...)`.
  @@index([userId])
}

/// A note one org member wrote about one PERSON, visible to the whole
/// organization.
///
/// ORG-VISIBLE AND ATTRIBUTED, DELIBERATELY
/// ----------------------------------------
/// This is the opposite decision from `ConnectionMark` and
/// `RelationshipStrengthScore`, which are private to one member. A thumbs-up is
/// one person's read of a prospect; a note is the shared context the product
/// exists to pool ("spoke to them at the Bangalore event, they own the budget").
/// It sits beside the org-coverage box on the prospect page for exactly that
/// reason, so it carries `organizationId` rather than `userId` as its scope,
/// and `authorId` so a reader always knows whose observation they are reading.
///
/// AUTHORIZATION: any member of the owning org may create a note. Deletion is
/// restricted server-side to the note's own author, plus org ADMINs, who need a
/// way to remove something inappropriate from a shared surface. Enforced in
/// `src/app/api/prospects/notes/[id]/route.ts` by putting both scopes in the
/// WHERE clause of a `deleteMany`, so a hand-crafted request deletes zero rows.
///
/// KEYED ON `identityKey`, like `ConnectionMark`: notes about a person must
/// survive the next import, which replaces every `Connection` row. Not an FK
/// for the same reason — the person outlives any single connection row.
model ProspectNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The stable person key — see the note above.
  identityKey    String
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// The only read path: one person's notes for one org, newest first.
  @@index([organizationId, identityKey, createdAt])
  @@index([authorId])
}


/// "Who should reach out to whom, for what" — org-wide, spanning every member's
/// connection graph rather than one person's import.
///
/// `sourceUserId` is the org member who holds the relationship; `targetConnectionId`
/// is the person they should approach. Both are FKs, so a suggestion cannot
/// outlive the rows it names.
///
/// IDEMPOTENCY: unique on (organizationId, sourceUserId, targetConnectionId), so
/// a nightly regeneration updates the existing row instead of stacking
/// duplicates — and a suggestion the user dismissed STAYS dismissed across
/// regenerations, because `dismissed` is never reset on update.
model QuickSuggestion {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The org member who should make the approach.
  sourceUserId       String
  sourceUser         User         @relation(fields: [sourceUserId], references: [id], onDelete: Cascade)
  /// The connection to approach.
  targetConnectionId String
  targetConnection   Connection   @relation(fields: [targetConnectionId], references: [id], onDelete: Cascade)
  title              String
  /// One or two sentences: what to do and why now.
  suggestionText     String
  /// Grounding for the suggestion (matched ICP, relationship score, message
  /// counts) so the UI can show what it was built from rather than asking the
  /// reader to trust it.
  metadata           Json?
  dismissed          Boolean      @default(false)
  dismissedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, sourceUserId, targetConnectionId])
  @@index([organizationId])
  @@index([organizationId, dismissed, createdAt])
  @@index([sourceUserId])
  @@index([targetConnectionId])
}

/// Phase 7. Fixed-window counter backing the AI rate limiter.
///
/// WHY POSTGRES AND NOT KV/REDIS
/// -----------------------------
/// Vercel runs this app on serverless instances that are created, frozen and
/// discarded per request, so an in-memory counter is not a rate limit at all —
/// it resets whenever a new instance is spun up and is per-instance even when
/// it survives. That leaves a shared store. `@vercel/kv`/Upstash would be the
/// textbook answer, but it is another service to provision, pay for, and keep
/// alive; Postgres is ALREADY a hard dependency of every route this limiter
/// protects (ProspectAsk cannot answer without it — it persists every turn to
/// `ChatMessage`). A counter here therefore adds no new failure mode and no new
/// infrastructure. The cost is one indexed upsert per AI request, which is
/// negligible next to a multi-second Groq call.
///
/// SHAPE
/// -----
/// One row per (subject, bucket, window kind, window start). A window is a
/// truncated clock hour or UTC day, so the row for the current window is found
/// by a single unique-index lookup and incremented with
/// `INSERT ... ON CONFLICT DO UPDATE`, which is atomic under concurrency.
/// Expired rows are pruned opportunistically; they are pure cache and can be
/// deleted at any time without affecting correctness (a deleted window simply
/// restarts at zero, and only ever for a window that has already elapsed).
model AiUsageCounter {
  id          String   @id @default(cuid())
  /// `user:<userId>` or `org:<organizationId>`.
  subjectKey  String
  /// Which limit this counts, e.g. `prospect-ask`, `recompute`, `org-total`.
  bucket      String
  /// `hour` or `day`. Named `windowKind` because `window` is a SQL keyword.
  windowKind  String
  /// Start of the window, truncated (UTC).
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectKey, bucket, windowKind, windowStart])
  @@index([windowStart])
}

model ChatMessage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  role           String
  content        String
  toolCalls      Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([conversationId])
  /// A conversation is always replayed in order, scoped to its owner — this is
  /// the index that read path actually uses.
  @@index([userId, conversationId, createdAt])
}
