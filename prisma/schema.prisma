// ProspectFlow — Prisma schema
// Full data model per the approved build plan. Only the Organization/User
// pieces are wired up to application code in Phase 1 (Foundation); the rest
// of the models exist now so later phases can build on a stable schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / org
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MEMBER
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  emailDomain String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  icps             ICP[]
  channelPartners  ChannelPartner[]
  quickSuggestions QuickSuggestion[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(MEMBER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastImportAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  importBatches             ImportBatch[]
  campaigns                 Campaign[]
  chatMessages               ChatMessage[]
  relationshipStrengthScores RelationshipStrengthScore[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Ingestion
// ---------------------------------------------------------------------------

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model ImportBatch {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ImportBatchStatus @default(PENDING)
  blobUrl   String
  fileCount Int?
  errorMessage String?
  /// Display name of the account owner for this export, resolved at ingestion
  /// time from Profile.csv when present, else from `User.name`. Used to decide
  /// which party in a message/invitation is the counterparty. Null on batches
  /// imported before this field existed.
  ownerName String?
  /// `computeNameKey(ownerName)` — precomputed so counterparty resolution never
  /// has to re-normalize at query time.
  ownerNameKey String?
  createdAt DateTime          @default(now())
  completedAt DateTime?

  connections  Connection[]
  positions    Position[]
  invitations  Invitation[]
  messages     MessageRecord[]
  rawCsvRows   RawCsvRow[]

  jobChangeEventsAsPrevious JobChangeEvent[] @relation("PreviousBatch")
  jobChangeEventsAsCurrent  JobChangeEvent[] @relation("CurrentBatch")

  @@index([userId])
  @@index([userId, status, completedAt])
}

model Connection {
  id            String   @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  /// Strong key: `url:<normalized profile url>`, else `fallback:sha256(...)`.
  identityKey   String
  /// Weak key: `name:<normalized display name>`. Non-unique — see
  /// src/lib/ingestion/identity-key.ts. Null on pre-existing rows.
  nameKey       String?
  firstName     String?
  lastName      String?
  linkedinUrl   String?
  email         String?
  company       String?
  position      String?
  connectedOn   DateTime?
  country       String?
  createdAt     DateTime @default(now())

  prospectMatches           ProspectMatch[]
  campaignLeads             CampaignLead[]
  relationshipStrengthScores RelationshipStrengthScore[]

  @@index([importBatchId])
  @@index([identityKey])
  @@index([nameKey])
  @@index([importBatchId, identityKey])
}

/// The ACCOUNT OWNER's own work history, from `Positions.csv`.
///
/// This is emphatically NOT the job history of the user's connections — a
/// LinkedIn export only ever contains the owner's positions. Connection job
/// changes are detected by diffing `Connection.company` / `Connection.position`
/// between batches (see `diffJobChanges`), never from this table.
model Position {
  id            String   @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  identityKey   String
  /// Always true for rows ingested from `Positions.csv`. Present so the
  /// "these are the owner's jobs, not a connection's" fact is queryable and
  /// this table is never mistaken for connection history again.
  isAccountOwner Boolean @default(true)
  companyName   String?
  title         String?
  location      String?
  startedOn     DateTime?
  finishedOn    DateTime?
  createdAt     DateTime @default(now())

  @@index([importBatchId])
  @@index([identityKey])
}

model Invitation {
  id            String   @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  /// Keyed to the COUNTERPARTY (the other person, not the account owner).
  identityKey   String
  /// Weak key for the counterparty: `name:<normalized display name>`.
  nameKey       String?
  /// The counterparty's display name, as it appeared in the export.
  counterpartyName String?
  direction     String?
  from          String?
  to            String?
  sentAt        DateTime?
  message       String?
  createdAt     DateTime @default(now())

  @@index([importBatchId])
  @@index([identityKey])
  @@index([nameKey])
}

model MessageRecord {
  id             String   @id @default(cuid())
  importBatchId  String
  importBatch    ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  /// Keyed to the COUNTERPARTY, never to the account owner — so a conversation
  /// is retrievable by "who it is with" regardless of who sent each message.
  /// Direction is carried separately by `senderIsUser`.
  identityKey    String
  /// Weak key for the counterparty: `name:<normalized display name>`.
  nameKey        String?
  /// The counterparty's display name, as it appeared in the export.
  counterpartyName String?
  /// True when the account owner sent this message. Null when the owner could
  /// not be identified (legacy rows, or an export with no Profile.csv and no
  /// usable `User.name`).
  senderIsUser   Boolean?
  conversationId String?
  from           String?
  to             String?
  sentAt         DateTime?
  content        String?
  createdAt      DateTime @default(now())

  @@index([importBatchId])
  @@index([identityKey])
  @@index([nameKey])
  @@index([conversationId])
}

model RawCsvRow {
  id             String   @id @default(cuid())
  importBatchId  String
  importBatch    ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  sourceFilename String
  rowData        Json
  createdAt      DateTime @default(now())

  @@index([importBatchId])
  @@index([sourceFilename])
}

/// A connection whose company or title differs between the two most recent
/// COMPLETE import batches for a user. Derived from `Connection` rows — the
/// only place a connection's employer actually appears in a LinkedIn export.
model JobChangeEvent {
  id                String   @id @default(cuid())
  /// The `Connection.identityKey` of the person who moved.
  identityKey       String
  /// Denormalized display details, captured at detection time so the UI can
  /// render the alert without a second lookup (and so it still reads correctly
  /// if the person disappears from a later export).
  personName        String?
  linkedinUrl       String?
  previousBatchId   String
  previousBatch     ImportBatch @relation("PreviousBatch", fields: [previousBatchId], references: [id], onDelete: Cascade)
  currentBatchId    String
  currentBatch      ImportBatch @relation("CurrentBatch", fields: [currentBatchId], references: [id], onDelete: Cascade)
  previousTitle     String?
  previousCompany   String?
  newTitle          String?
  newCompany        String?
  detectedAt        DateTime @default(now())

  @@index([identityKey])
  @@index([currentBatchId])
}

// ---------------------------------------------------------------------------
// ICP / channel partner matching
// ---------------------------------------------------------------------------

model ICP {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  country        String?
  industry       String?
  positions      String[]
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prospectMatches ProspectMatch[]

  @@index([organizationId])
}

model ChannelPartner {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  industry       String?
  criteria       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prospectMatches ProspectMatch[]

  @@index([organizationId])
}

/// Which kind of definition a match was scored against. Redundant with
/// `icpId`/`channelPartnerId` being set, but stored explicitly so dashboards
/// can filter on one indexed column instead of a null-check.
enum MatchType {
  ICP
  CHANNEL_PARTNER
}

/// A scored link between one `Connection` and one `ICP` or `ChannelPartner`.
///
/// IDEMPOTENCY: exactly one of `icpId` / `channelPartnerId` is set, and the
/// pair (connection, definition) is UNIQUE. Re-scoring therefore upserts in
/// place — re-running the matching job, or re-saving an ICP, updates the score
/// and rationale rather than accumulating duplicate rows. Postgres treats
/// NULLs as distinct in unique indexes, so the two constraints below never
/// collide with each other.
model ProspectMatch {
  id               String   @id @default(cuid())
  connectionId     String
  connection       Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  matchType        MatchType
  icpId            String?
  icp              ICP? @relation(fields: [icpId], references: [id], onDelete: Cascade)
  channelPartnerId String?
  channelPartner   ChannelPartner? @relation(fields: [channelPartnerId], references: [id], onDelete: Cascade)
  score            Int
  rationale        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([connectionId, icpId])
  @@unique([connectionId, channelPartnerId])
  @@index([connectionId])
  @@index([icpId, score])
  @@index([channelPartnerId, score])
  @@index([matchType, score])
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

enum CampaignLeadStatus {
  REQUEST_PENDING
  REQUEST_ACCEPTED
  FIRST_MESSAGE_SENT
  CONVERSATION_ONGOING
}

/// Lifecycle of an uploaded lead list, mirroring `ImportBatchStatus` — with one
/// extra state, because campaign ingestion deliberately pauses for a human.
///
///   PENDING               blob uploaded, detection queued
///   DETECTING             background job is sampling the file
///   AWAITING_CONFIRMATION detection finished; the user must confirm (or
///                         override) the LinkedIn-URL column before any lead is
///                         written. The detected column drives every downstream
///                         match, so a silent wrong guess is costly.
///   PROCESSING            confirmed; leads are being created and linked
///   COMPLETE / FAILED     terminal
enum CampaignStatus {
  PENDING
  DETECTING
  AWAITING_CONFIRMATION
  PROCESSING
  COMPLETE
  FAILED
}

model Campaign {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  sourceFileName String?
  status    CampaignStatus @default(PENDING)
  /// Vercel Blob URL of the uploaded spreadsheet. The store is private, so it
  /// is only ever read server-side via `get()` from `@vercel/blob`.
  blobUrl   String?
  /// The column the user CONFIRMED holds LinkedIn profile URLs. Null until
  /// confirmation; this — not `detectedColumn` — is what lead creation reads.
  linkedinColumn String?
  /// What detection proposed, kept alongside the confirmed value so an
  /// override stays visible/auditable.
  detectedColumn String?
  detectionConfidence Float?
  /// "heuristic" | "heuristic-weak" | "llm" | "none" — see
  /// src/lib/campaigns/detect-column.ts.
  detectionMethod String?
  /// Header row of the uploaded sheet, so the override picker can be rendered
  /// without re-downloading and re-parsing the blob.
  columnHeaders String[]
  /// The same sampled rows detection ran on, as `Record<string,string>[]`.
  /// Bounded to `DETECTION_SAMPLE_ROWS`, purely for the confirmation preview.
  sampleRows Json?
  leadCount Int?
  /// How many leads resolved to a `Connection` in the user's latest completed
  /// import. Surfaced so "not yet scored" rows are explained rather than
  /// looking broken.
  matchedLeadCount Int?
  errorMessage String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads CampaignLead[]

  @@index([userId])
  @@index([userId, createdAt])
  /// The client looks its just-uploaded campaign up by the blob URL that
  /// `uploadPresigned` returned (scoped to the session user), so this lookup
  /// needs to be indexed.
  @@index([blobUrl])
}

model CampaignLead {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  linkedinUrl  String?
  firstName    String?
  lastName     String?
  company      String?
  position     String?
  /// Same key design as ingestion (src/lib/ingestion/identity-key.ts):
  /// `identityKey` is `url:<normalized profile url>` when the sheet gave a
  /// URL, `nameKey` is the weak name fallback. Stored rather than recomputed
  /// so leads can be re-linked against a future import without re-parsing the
  /// original spreadsheet.
  identityKey  String?
  nameKey      String?
  status       CampaignLeadStatus @default(REQUEST_PENDING)
  rawRow       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaignId])
  @@index([connectionId])
  @@index([campaignId, status])
  @@index([identityKey])
  @@index([nameKey])
}

// ---------------------------------------------------------------------------
// AI features
// ---------------------------------------------------------------------------

model RelationshipStrengthScore {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  score        Int
  factors      Json
  computedAt   DateTime @default(now())

  @@index([userId])
  @@index([connectionId])
}

model QuickSuggestion {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  role           String
  content        String
  toolCalls      Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([conversationId])
}
