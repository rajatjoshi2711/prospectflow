# --- Required for Phase 1 (Foundation) ---

# Postgres connection string. Provision a Postgres instance (local, Vercel
# Postgres, Neon, Supabase, etc.) and paste its connection string here.
DATABASE_URL="postgresql://user:password@localhost:5432/prospectflow?schema=public"

# Random secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Required for Phase 2 (Ingestion) ---

# Vercel Blob (direct-to-blob zip uploads) uses OIDC auth — there is no
# long-lived token to manage. Create a Blob store in your Vercel project
# (Storage -> Create Database -> Blob) and connect it to the project; Vercel
# then injects BLOB_STORE_ID, VERCEL_OIDC_TOKEN and BLOB_WEBHOOK_PUBLIC_KEY
# automatically on every deployment. For local development, run
# `vercel env pull` in a linked project to fetch them into `.env.local`
# (VERCEL_OIDC_TOKEN is short-lived — re-run `vercel env pull` when it
# expires). BLOB_READ_WRITE_TOKEN is NOT required and is not read by any code.
BLOB_STORE_ID=""
VERCEL_OIDC_TOKEN=""
BLOB_WEBHOOK_PUBLIC_KEY=""

# Only needed for local testing of the *full* upload flow: Vercel's
# onUploadCompleted webhook cannot reach `localhost`, so point this at a
# public tunnel (e.g. `ngrok http 3000`) to receive the callback locally.
# VERCEL_BLOB_CALLBACK_URL="https://your-tunnel.ngrok-free.app"

# Inngest event/signing keys for the background ingestion pipeline. Not
# required for local development against `npx inngest-cli@latest dev` (it
# talks to your Next.js dev server directly); required in production/Vercel
# so Inngest's cloud can authenticate with your app. Get these from
# https://app.inngest.com after creating an app.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Required for Phase 4 (ICP / channel partner matching) ---

# Groq API key, used for GPT-OSS-120B via Groq's OpenAI-compatible endpoint
# (https://api.groq.com/openai/v1). Get one at https://console.groq.com/keys.
#
# OPTIONAL, and deliberately so. When it is absent, ICP / channel-partner
# matching still runs: it falls back to the deterministic keyword pre-filter
# and labels every rationale "(AI scoring unavailable)". Imports, dashboards
# and every other route are unaffected — nothing is instantiated at module
# load, so a missing key can never break an unrelated page.
GROQ_API_KEY=""

# Optional overrides. LLM_PROVIDER selects the implementation in
# src/lib/ai/index.ts (only "groq" today). GROQ_MODEL pins a different Groq
# model slug; the default is openai/gpt-oss-120b.
# LLM_PROVIDER="groq"
# GROQ_MODEL="openai/gpt-oss-120b"

# Used only when the primary model cannot serve a request (out of credits,
# over quota, or rate limited). Half the price and supports the same
# browser_search tool. Set to an empty value to disable the fallback.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Required for Phase 6 (AI depth) ---

# Shared secret for the nightly AI sweep at /api/cron/ai-sweep, which
# re-scores relationship strength and regenerates org-wide quick suggestions.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`. Set it in the
# Vercel project's environment variables (Settings -> Environment Variables);
# Vercel then uses the same value when firing the cron defined in vercel.json.
#
# Without it the route refuses with 503 rather than running unauthenticated —
# it fans out work across every organization, so it must never be open. The
# rest of Phase 6 is unaffected: relationship scores and quick suggestions are
# still generated after each import, they just do not refresh overnight.
CRON_SECRET=""

# GROQ_API_KEY above is used by Phase 6 too, and is still optional there:
#   - relationship strength falls back to the deterministic rule-based score,
#     stored with basis "heuristic" so the UI can say which it is;
#   - quick suggestions fall back to a ranked list, clearly labelled;
#   - ProspectAsk refuses honestly ("AI is not configured") rather than
#     fabricating an answer.

# --- Phase 7 (Polish): AI cost guardrails ---

# Every route that can reach a model is rate limited per user and per
# organization. Counters live in Postgres (`AiUsageCounter`) — deliberately, so
# no extra service has to be provisioned; see src/lib/ai/rate-limit.ts for why
# in-memory counters do not work on serverless and why Upstash/KV was not used.
#
# All of these are OPTIONAL. The defaults shown are what applies when unset, and
# a value that is not a positive integer falls back to the default rather than
# disabling the guardrail.

# ProspectAsk chat. One question costs up to 5 Groq calls (4 tool rounds plus a
# forced final answer), so this is the limit that actually bounds spend.
# AI_CHAT_LIMIT_PER_HOUR="20"
# AI_CHAT_LIMIT_PER_DAY="100"

# The "re-score now" control on the dashboard. One press queues a scoring run
# worth up to ~27 model calls, and the run is idempotent, so this is tight.
# AI_RECOMPUTE_LIMIT_PER_HOUR="3"
# AI_RECOMPUTE_LIMIT_PER_DAY="10"

# Prospect research (the Research box on a prospect page). The most expensive
# request in the app: one live web search plus a generation over what it
# retrieved, via Groq's server-side browser_search tool. Results are saved and
# org-visible, so a colleague reads an existing run instead of paying again —
# which is why this is tighter than chat.
# AI_RESEARCH_LIMIT_PER_HOUR="10"
# AI_RESEARCH_LIMIT_PER_DAY="30"

# Org-wide daily ceiling across every AI-invoking request from every member.
# A backstop for the case where ten people each stay inside their own limit.
# AI_ORG_LIMIT_PER_DAY="600"

# Set to "false" to disable rate limiting entirely. Intended for local
# development only. Any other value (including unset) leaves it ON.
# AI_RATE_LIMIT_ENABLED="true"
