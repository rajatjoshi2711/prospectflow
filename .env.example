# --- Required for Phase 1 (Foundation) ---

# Postgres connection string. Provision a Postgres instance (local, Vercel
# Postgres, Neon, Supabase, etc.) and paste its connection string here.
DATABASE_URL="postgresql://user:password@localhost:5432/prospectflow?schema=public"

# Random secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Required for Phase 2 (Ingestion) ---

# Vercel Blob (direct-to-blob zip uploads) uses OIDC auth — there is no
# long-lived token to manage. Create a Blob store in your Vercel project
# (Storage -> Create Database -> Blob) and connect it to the project; Vercel
# then injects BLOB_STORE_ID, VERCEL_OIDC_TOKEN and BLOB_WEBHOOK_PUBLIC_KEY
# automatically on every deployment. For local development, run
# `vercel env pull` in a linked project to fetch them into `.env.local`
# (VERCEL_OIDC_TOKEN is short-lived — re-run `vercel env pull` when it
# expires). BLOB_READ_WRITE_TOKEN is NOT required and is not read by any code.
BLOB_STORE_ID=""
VERCEL_OIDC_TOKEN=""
BLOB_WEBHOOK_PUBLIC_KEY=""

# Only needed for local testing of the *full* upload flow: Vercel's
# onUploadCompleted webhook cannot reach `localhost`, so point this at a
# public tunnel (e.g. `ngrok http 3000`) to receive the callback locally.
# VERCEL_BLOB_CALLBACK_URL="https://your-tunnel.ngrok-free.app"

# Inngest event/signing keys for the background ingestion pipeline. Not
# required for local development against `npx inngest-cli@latest dev` (it
# talks to your Next.js dev server directly); required in production/Vercel
# so Inngest's cloud can authenticate with your app. Get these from
# https://app.inngest.com after creating an app.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Coming in later phases (not read by any code yet) ---

# Phase 6: Groq API key for GPT-OSS-120B (ProspectAsk, scoring, match rationale).
GROQ_API_KEY=""
