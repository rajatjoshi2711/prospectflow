# --- Required for Phase 1 (Foundation) ---

# Postgres connection string. Provision a Postgres instance (local, Vercel
# Postgres, Neon, Supabase, etc.) and paste its connection string here.
DATABASE_URL="postgresql://user:password@localhost:5432/prospectflow?schema=public"

# Random secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Coming in later phases (not read by any code yet) ---

# Phase 6: Groq API key for GPT-OSS-120B (ProspectAsk, scoring, match rationale).
GROQ_API_KEY=""

# Phase 2: Vercel Blob token for direct-to-blob zip/Excel uploads.
BLOB_READ_WRITE_TOKEN=""

# Phase 2: Inngest event/signing keys for the background ingestion pipeline.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
